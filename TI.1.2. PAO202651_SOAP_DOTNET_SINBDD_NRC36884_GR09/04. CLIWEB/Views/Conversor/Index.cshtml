@model ClienteWeb_DotNet_SOAP_GR09.Modelos.ConversionViewModel
@{
    Layout = null;
    string usuario = ViewBag.Usuario as string ?? "MONSTER";
    string token = ViewBag.Token as string ?? "";
    string tokenAbreviado = ViewBag.TokenAbreviado as string ?? "...";
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Conversor de Unidades SOAP .NET - Panel Web (GR09)</title>
    <link rel="stylesheet" href="~/css/style.css">
</head>
<body>

    <!-- Encabezado con sesión activa -->
    <header class="header-bar">
        <div class="header-brand">
            <h1>CONVERSOR DE UNIDADES (SOAP .NET · SINBDD)</h1>
            <p>ESPE · Arquitectura de Software (TI.1.2) | Autor: Julio Enrique Viche Castillo</p>
        </div>
        <div class="header-user">
            <span class="badge-session">
                <span class="status-dot">●</span> 
                <strong>@usuario</strong>
                <span style="opacity: 0.8; font-size: 0.75rem;">(Token: @tokenAbreviado)</span>
            </span>
            <a href="/logout" class="btn-logout">Cerrar Sesión</a>
        </div>
    </header>

    <!-- Panel Central del Conversor -->
    <main class="main-wrapper">
        <div class="card-box">
            <h2 class="card-title">Conversor de Unidades Multimagnitud</h2>
            <p class="card-subtitle">Cálculos procesados mediante servicios web SOAP XML protegidos por token</p>

            @if (!string.IsNullOrEmpty(Model.MensajeError))
            {
                <div class="alert alert-error">
                    @Model.MensajeError
                </div>
            }

            <!-- 1. Pestañas de Magnitud -->
            <label class="form-label">1. Seleccione la Magnitud Física:</label>
            <div class="segmented-group">
                <button type="button" class="segment-btn @("Longitud".Equals(Model.Magnitud, StringComparison.OrdinalIgnoreCase) ? "active" : "")"
                        onclick="cambiarMagnitud('Longitud')">
                    Longitud
                </button>
                <button type="button" class="segment-btn @("Masa".Equals(Model.Magnitud, StringComparison.OrdinalIgnoreCase) ? "active" : "")"
                        onclick="cambiarMagnitud('Masa')">
                    Masa
                </button>
                <button type="button" class="segment-btn @("Temperatura".Equals(Model.Magnitud, StringComparison.OrdinalIgnoreCase) ? "active" : "")"
                        onclick="cambiarMagnitud('Temperatura')">
                    Temperatura
                </button>
            </div>

            <!-- Formulario de Conversión -->
            <form action="/convertir" method="POST" id="formConversion">
                <input type="hidden" id="inputMagnitud" name="magnitud" value="@Model.Magnitud">

                <!-- 2. Valor Numérico -->
                <div class="form-group">
                    <label class="form-label" for="txtValor">2. Ingrese el Valor a Convertir:</label>
                    <input type="text" id="txtValor" name="valor" class="form-input" 
                           autocomplete="off" inputmode="decimal" maxlength="16" pattern="^-?\d+(\.\d+)?$"
                           title="Solo se permiten números, el punto decimal '.' y '-' al inicio (ej. 100, -15.5 o 25.5)"
                           onkeypress="return (event.charCode >= 48 && event.charCode <= 57) || (event.charCode === 46 && this.value.indexOf('.') === -1) || (event.charCode === 45 && this.selectionStart === 0 && this.value.indexOf('-') === -1)"
                           oninput="let isNeg = this.value.startsWith('-'); let clean = this.value.replace(/[^0-9.]/g, '').replace(/(\..*?)\..*/g, '$1'); this.value = ((isNeg ? '-' : '') + clean).slice(0, 16);" 
                           value="@Model.Valor.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)" required style="font-size: 1.15rem; font-weight: bold;">
                </div>

                <!-- 3. Unidades Origen -> Destino con Intercambio -->
                <div class="conversion-units-row">
                    <div>
                        <label class="form-label" for="cmbOrigen">De (Unidad de Origen):</label>
                        <select id="cmbOrigen" name="unidadOrigen" class="form-select" required></select>
                    </div>

                    <div>
                        <button type="button" class="btn-swap" onclick="intercambiarUnidades()" title="Intercambiar unidades (Origen ⇄ Destino)">
                            &#8644;
                        </button>
                    </div>

                    <div>
                        <label class="form-label" for="cmbDestino">A (Unidad de Destino):</label>
                        <select id="cmbDestino" name="unidadDestino" class="form-select" required></select>
                    </div>
                </div>

                <button type="submit" class="btn-primary">Calcular Conversión SOAP</button>
            </form>

            <!-- 4. Tarjeta de Resultado -->
            @if (Model.Resultado.HasValue && Model.Exito)
            {
                <div class="result-card">
                    <div class="result-value" id="resultadoTexto">
                        @Model.Valor.ToString("F2", System.Globalization.CultureInfo.InvariantCulture) @Model.UnidadOrigen = @Model.Resultado.Value.ToString("F2", System.Globalization.CultureInfo.InvariantCulture) @Model.UnidadDestino
                    </div>
                    <div class="result-subtext">
                        Cálculo procesado exitosamente por el Servidor SOAP .NET (SINBDD).
                    </div>
                    <button type="button" class="btn-copy" onclick="copiarResultado()">Copiar Resultado</button>
                </div>
            }

        </div>
    </main>

    <!-- Barra de Estado Inferior -->
    <footer class="footer-bar">
        <span>Servidor Backend SOAP: <code>http://192.168.137.1:8733/ServidorSOAP</code></span>
        <span>Arquitectura: Modelo - Vista - Controlador (ASP.NET Core MVC / .NET 10)</span>
    </footer>

    <!-- Catálogo de JavaScript para unidades dinámicas (Exactamente 5 unidades por catálogo) -->
    <script>
        const CATALOGO = {
            'Longitud': ['Metro', 'Centimetro', 'Pie', 'Yarda', 'Milla'],
            'Masa': ['Gramo', 'Kilogramo', 'Libra', 'Onza', 'Quintal'],
            'Temperatura': ['Celsius', 'Fahrenheit', 'Kelvin', 'Newton', 'Reaumur']
        };

        const unidadOrigenPrevia = '@Model.UnidadOrigen';
        const unidadDestinoPrevia = '@Model.UnidadDestino';

        function cambiarMagnitud(magnitud) {
            document.getElementById('inputMagnitud').value = magnitud;

            document.querySelectorAll('.segment-btn').forEach(btn => {
                btn.classList.remove('active');
                if (btn.innerText.trim().toLowerCase() === magnitud.toLowerCase()) {
                    btn.classList.add('active');
                }
            });

            const cmbOrigen = document.getElementById('cmbOrigen');
            const cmbDestino = document.getElementById('cmbDestino');
            cmbOrigen.innerHTML = '';
            cmbDestino.innerHTML = '';

            const unidades = CATALOGO[magnitud] || [];
            unidades.forEach((u, idx) => {
                const opt1 = new Option(u, u);
                const opt2 = new Option(u, u);
                cmbOrigen.add(opt1);
                cmbDestino.add(opt2);
            });

            if (unidades.length > 1) {
                cmbDestino.selectedIndex = 1;
            }

            if (unidadOrigenPrevia && unidades.includes(unidadOrigenPrevia)) {
                cmbOrigen.value = unidadOrigenPrevia;
            }
            if (unidadDestinoPrevia && unidades.includes(unidadDestinoPrevia)) {
                cmbDestino.value = unidadDestinoPrevia;
            }
        }

        function intercambiarUnidades() {
            const cmbOrigen = document.getElementById('cmbOrigen');
            const cmbDestino = document.getElementById('cmbDestino');
            const temp = cmbOrigen.value;
            cmbOrigen.value = cmbDestino.value;
            cmbDestino.value = temp;
        }

        function copiarResultado() {
            const texto = document.getElementById('resultadoTexto').innerText.trim();
            navigator.clipboard.writeText(texto).then(() => {
                const btn = event.target;
                const orig = btn.innerText;
                btn.innerText = '¡Copiado!';
                setTimeout(() => { btn.innerText = orig; }, 1500);
            });
        }

        window.onload = function() {
            cambiarMagnitud('@Model.Magnitud');
        };
    </script>

</body>
</html>
