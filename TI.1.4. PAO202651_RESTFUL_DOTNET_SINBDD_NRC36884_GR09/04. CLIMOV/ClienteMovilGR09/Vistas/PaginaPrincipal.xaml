<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ClienteMovilGR09.PaginaPrincipal"
             Shell.NavBarIsVisible="False"
             Title="Conversor de Unidades RESTful (.NET MAUI)"
             BackgroundColor="#F8FAFC">

    <ScrollView x:Name="Desplazamiento" VerticalScrollBarVisibility="Never">
        <VerticalStackLayout Padding="20,24,20,32" Spacing="16" MaximumWidthRequest="540" HorizontalOptions="Center">

            <!-- Cabecera Institucional ESPE (Idéntica al cliente Android Java) -->
            <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
                <Label Text="UNIVERSIDAD DE LAS FUERZAS ARMADAS ESPE"
                       TextColor="#0F3C6E"
                       FontSize="13"
                       FontAttributes="Bold"
                       HorizontalTextAlignment="Center"
                       CharacterSpacing="0.5" />
                <Label Text="Conversor de Unidades (RESTful .NET MAUI)"
                       TextColor="#64748B"
                       FontSize="12"
                       HorizontalTextAlignment="Center" />
                <Label Text="NRC: 36884 | Grupo: GR09 | Julio Viche - Gabriel Murillo"
                       TextColor="#64748B"
                       FontSize="11"
                       HorizontalTextAlignment="Center" />
            </VerticalStackLayout>

            <!-- PANEL 1: INICIO DE SESIÓN -->
            <Border x:Name="panelLogin"
                    BackgroundColor="#FFFFFF"
                    Stroke="#E2E8F0"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 14"
                    Padding="20"
                    Margin="0,6,0,0">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Inicio de Sesión"
                           TextColor="#1E293B"
                           FontSize="20"
                           FontAttributes="Bold" />
                    <Label Text="Credenciales fijas: MONSTER / MONSTER9 (SINBDD)"
                           TextColor="#64748B"
                           FontSize="12"
                           Margin="0,0,0,8" />

                    <!-- Campo Usuario -->
                    <Label Text="Usuario"
                           TextColor="#475569"
                           FontSize="12"
                           FontAttributes="Bold" />
                    <Border Stroke="#CBD5E1"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 8"
                            Padding="12,0"
                            BackgroundColor="#FFFFFF">
                        <Entry x:Name="txtUsuario"
                               Text="MONSTER"
                               Placeholder="Ingrese usuario"
                               TextColor="#1E293B"
                               PlaceholderColor="#94A3B8"
                               FontSize="15"
                               HeightRequest="48"
                               ReturnType="Next" />
                    </Border>

                    <!-- Campo Contraseña -->
                    <Label Text="Contraseña"
                           TextColor="#475569"
                           FontSize="12"
                           FontAttributes="Bold"
                           Margin="0,4,0,0" />
                    <Border Stroke="#CBD5E1"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 8"
                            Padding="12,0"
                            BackgroundColor="#FFFFFF">
                        <Entry x:Name="txtClave"
                               Text="MONSTER9"
                               Placeholder="Ingrese contraseña"
                               IsPassword="True"
                               TextColor="#1E293B"
                               PlaceholderColor="#94A3B8"
                               FontSize="15"
                               HeightRequest="48"
                               ReturnType="Go"
                               Completed="IniciarSesion_Clicked" />
                    </Border>

                    <HorizontalStackLayout Spacing="6" Margin="0,4,0,0">
                        <CheckBox x:Name="chkMostrarClave"
                                  Color="#0F3C6E"
                                  CheckedChanged="AlMostrarContrasenia" />
                        <Label Text="Mostrar contraseña"
                               TextColor="#64748B"
                               FontSize="13"
                               VerticalOptions="Center" />
                    </HorizontalStackLayout>

                    <!-- Mensaje de Error -->
                    <Label x:Name="lblMensajeLogin"
                           TextColor="#DC2626"
                           FontSize="12"
                           IsVisible="False"
                           Margin="0,4,0,0" />

                    <!-- Indicador de Carga -->
                    <ActivityIndicator x:Name="indicadorLogin"
                                       Color="#0F3C6E"
                                       HeightRequest="32"
                                       IsRunning="False"
                                       IsVisible="False"
                                       Margin="0,6,0,0" />

                    <!-- Botón Ingresar -->
                    <Button x:Name="btnIngresar"
                            Text="Ingresar al Conversor"
                            BackgroundColor="#0F3C6E"
                            TextColor="#FFFFFF"
                            FontAttributes="Bold"
                            FontSize="15"
                            CornerRadius="8"
                            HeightRequest="50"
                            Margin="0,10,0,0"
                            Clicked="IniciarSesion_Clicked" />
                </VerticalStackLayout>
            </Border>

            <!-- PANEL 2: CONVERTIDOR DE UNIDADES (Visible tras autenticación) -->
            <VerticalStackLayout x:Name="panelConversion" IsVisible="False" Spacing="14">

                <!-- Barra Superior de Sesión Activa -->
                <Border BackgroundColor="#FFFFFF"
                        Stroke="#E2E8F0"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 10"
                        Padding="12,8">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10" VerticalOptions="Center">
                        <VerticalStackLayout Grid.Column="0" VerticalOptions="Center" Spacing="1">
                            <Label x:Name="txtUsuarioActivo"
                                   Text="Usuario: MONSTER"
                                   TextColor="#0F3C6E"
                                   FontSize="13"
                                   FontAttributes="Bold" />
                            <Label x:Name="txtTokenActivo"
                                   Text="Token: activo (SINBDD)"
                                   TextColor="#64748B"
                                   FontSize="11" />
                        </VerticalStackLayout>
                        <Button Grid.Column="1"
                                x:Name="btnSalir"
                                Text="Salir"
                                TextColor="#991B1B"
                                BackgroundColor="#FEE2E2"
                                CornerRadius="6"
                                HeightRequest="36"
                                Padding="14,0"
                                FontSize="11"
                                FontAttributes="Bold"
                                Clicked="CerrarSesion_Clicked" />
                    </Grid>
                </Border>

                <!-- Tarjeta Principal del Conversor -->
                <Border BackgroundColor="#FFFFFF"
                        Stroke="#E2E8F0"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 12"
                        Padding="18">
                    <VerticalStackLayout Spacing="12">

                        <!-- 1. Selección de Magnitud Física (Tabs estilo Toggle) -->
                        <Label Text="1. Magnitud Física:"
                               TextColor="#1E293B"
                               FontSize="13"
                               FontAttributes="Bold" />

                        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="6">
                            <Button Grid.Column="0"
                                    x:Name="btnTabLongitud"
                                    Text="Longitud"
                                    HeightRequest="40"
                                    CornerRadius="6"
                                    FontSize="12"
                                    FontAttributes="Bold"
                                    Clicked="TabLongitud_Clicked" />
                            <Button Grid.Column="1"
                                    x:Name="btnTabMasa"
                                    Text="Masa"
                                    HeightRequest="40"
                                    CornerRadius="6"
                                    FontSize="12"
                                    FontAttributes="Bold"
                                    Clicked="TabMasa_Clicked" />
                            <Button Grid.Column="2"
                                    x:Name="btnTabTemperatura"
                                    Text="Temp."
                                    HeightRequest="40"
                                    CornerRadius="6"
                                    FontSize="12"
                                    FontAttributes="Bold"
                                    Clicked="TabTemperatura_Clicked" />
                        </Grid>

                        <!-- 2. Valor Numérico a Convertir -->
                        <Label Text="2. Valor a Convertir (máx 16 caracteres, dígitos y '.'):"
                               TextColor="#1E293B"
                               FontSize="13"
                               FontAttributes="Bold"
                               Margin="0,8,0,0" />

                        <Border Stroke="#CBD5E1"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 8"
                                Padding="12,0"
                                BackgroundColor="#FFFFFF">
                            <Entry x:Name="txtValor"
                                   Text="100.00"
                                   MaxLength="16"
                                   Keyboard="Numeric"
                                   TextColor="#1E293B"
                                   FontSize="16"
                                   FontAttributes="Bold"
                                   HeightRequest="48"
                                   ReturnType="Go"
                                   Completed="Convertir_Clicked" />
                        </Border>

                        <!-- 3. Unidades Origen y Destino -->
                        <Label Text="3. Unidades (Origen y Destino):"
                               TextColor="#1E293B"
                               FontSize="13"
                               FontAttributes="Bold"
                               Margin="0,8,0,0" />

                        <Grid ColumnDefinitions="*,Auto,*" ColumnSpacing="6" VerticalOptions="Center">
                            <!-- Selector Origen -->
                            <Border Grid.Column="0"
                                    Stroke="#CBD5E1"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 8"
                                    Padding="8,0"
                                    HeightRequest="48"
                                    BackgroundColor="#FFFFFF">
                                <Picker x:Name="pickerOrigen"
                                        TextColor="#1E293B"
                                        TitleColor="#94A3B8"
                                        FontSize="13"
                                        VerticalOptions="Center" />
                            </Border>

                            <!-- Botón Swap (Intercambio) -->
                            <Button Grid.Column="1"
                                    x:Name="btnSwap"
                                    Text="⇄"
                                    BackgroundColor="#F1F5F9"
                                    TextColor="#0F3C6E"
                                    FontSize="18"
                                    FontAttributes="Bold"
                                    CornerRadius="22"
                                    WidthRequest="44"
                                    HeightRequest="44"
                                    Padding="0"
                                    Clicked="Swap_Clicked" />

                            <!-- Selector Destino -->
                            <Border Grid.Column="2"
                                    Stroke="#CBD5E1"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 8"
                                    Padding="8,0"
                                    HeightRequest="48"
                                    BackgroundColor="#FFFFFF">
                                <Picker x:Name="pickerDestino"
                                        TextColor="#1E293B"
                                        TitleColor="#94A3B8"
                                        FontSize="13"
                                        VerticalOptions="Center" />
                            </Border>
                        </Grid>

                        <!-- Botón Calcular -->
                        <Button x:Name="btnCalcular"
                                Text="Calcular Conversión RESTful (.NET MAUI)"
                                BackgroundColor="#0F3C6E"
                                TextColor="#FFFFFF"
                                FontAttributes="Bold"
                                FontSize="14"
                                CornerRadius="8"
                                HeightRequest="48"
                                Margin="0,12,0,0"
                                Clicked="Convertir_Clicked" />

                        <!-- Indicador de Cálculo -->
                        <ActivityIndicator x:Name="indicadorConversion"
                                           Color="#0F3C6E"
                                           HeightRequest="28"
                                           IsRunning="False"
                                           IsVisible="False" />

                        <!-- Mensaje de Error en Conversión -->
                        <Label x:Name="lblMensajeConversion"
                               TextColor="#DC2626"
                               FontSize="12"
                               IsVisible="False"
                               HorizontalTextAlignment="Center" />

                        <!-- 4. Tarjeta de Resultado (Mint / Emerald idéntica a Java) -->
                        <Border x:Name="cardResultado"
                                BackgroundColor="#F0FDF4"
                                Stroke="#99F6E4"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 10"
                                Padding="14"
                                Margin="0,8,0,0">
                            <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                                <Label x:Name="txtResultadoValor"
                                       Text="Presione 'Calcular Conversión'"
                                       TextColor="#0D9488"
                                       FontSize="16"
                                       FontAttributes="Bold"
                                       HorizontalTextAlignment="Center" />
                                <Label x:Name="txtResultadoDetalle"
                                       Text="Listo para despachar petición RESTful."
                                       TextColor="#64748B"
                                       FontSize="11"
                                       HorizontalTextAlignment="Center" />
                                <Button x:Name="btnCopiarResultado"
                                        Text="Copiar Resultado"
                                        TextColor="#0F3C6E"
                                        BackgroundColor="#FFFFFF"
                                        BorderColor="#CBD5E1"
                                        BorderWidth="1"
                                        CornerRadius="6"
                                        HeightRequest="34"
                                        Padding="14,0"
                                        FontSize="11"
                                        Margin="0,6,0,0"
                                        IsVisible="False"
                                        Clicked="CopiarResultado_Clicked" />
                            </VerticalStackLayout>
                        </Border>

                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>

            <!-- Pie de Página Institucional -->
            <Label Text="Arquitectura: Modelo - Vista - Controlador (.NET MAUI C#)"
                   TextColor="#94A3B8"
                   FontSize="10"
                   HorizontalTextAlignment="Center"
                   Margin="0,8,0,16" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
