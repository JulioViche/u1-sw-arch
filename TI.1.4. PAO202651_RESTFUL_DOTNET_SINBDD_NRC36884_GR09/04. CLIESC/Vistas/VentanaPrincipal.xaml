<Window x:Class="ClienteEscritorio_DotNet_REST_GR09.Vistas.VentanaPrincipal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Conversor de Unidades RESTful - Panel de Escritorio (GR09)" 
        Height="680" Width="760"
        WindowStartupLocation="CenterScreen"
        Background="#F1F5F9"
        FontFamily="Segoe UI">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="35"/>
        </Grid.RowDefinitions>

        <!-- Encabezado con Sesión Activa -->
        <Border Grid.Row="0" Background="#0F3C6E" Padding="20,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="CONVERSOR DE UNIDADES (RESTFUL .NET · SINBDD)" 
                               Foreground="#FFFFFF" FontWeight="Bold" FontSize="14"/>
                    <TextBlock Text="ESPE · Arquitectura de Software (TI.1.4) | Autor: Julio Enrique Viche Castillo" 
                               Foreground="#BAE6FD" FontSize="11" Margin="0,2,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#1E3A8A" BorderBrush="#3B82F6" BorderThickness="1" 
                            CornerRadius="16" Padding="12,5" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="●" Foreground="#34D399" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="LblUsuarioSesion" Text="MONSTER" Foreground="#FFFFFF" FontWeight="Bold" FontSize="11" VerticalAlignment="Center"/>
                            <TextBlock x:Name="LblTokenAbreviado" Text=" (Token: ...)" Foreground="#93C5FD" FontSize="10" Margin="4,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <Button x:Name="BtnCerrarSesion" Content="Cerrar Sesión" Style="{StaticResource DangerButton}" Click="BtnCerrarSesion_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Panel Central -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Border Background="#FFFFFF" Margin="24,18,24,18" CornerRadius="10" Padding="24"
                    BorderBrush="#CBD5E1" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" Opacity="0.06" BlurRadius="12" ShadowDepth="3"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="Conversor de Unidades Multimagnitud" FontSize="20" FontWeight="Bold" Foreground="#1E293B"/>
                    <TextBlock Text="Cálculos procesados mediante servicios web RESTful JSON protegidos por token" 
                               FontSize="13" Foreground="#64748B" Margin="0,2,0,18"/>

                    <!-- Mensaje de Error si ocurre -->
                    <Border x:Name="BrdError" Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1" 
                            CornerRadius="6" Padding="12,8" Margin="0,0,0,14" Visibility="Collapsed">
                        <TextBlock x:Name="LblError" Foreground="#B91C1C" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    </Border>

                    <!-- 1. Pestañas de Magnitud -->
                    <TextBlock Text="1. Seleccione la Magnitud Física:" FontWeight="SemiBold" FontSize="13" Foreground="#334155" Margin="0,0,0,8"/>
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="BtnTabLongitud" Grid.Column="0" Content="Longitud" Height="38" Margin="0,0,4,0" 
                                Background="#0284C7" Foreground="White" FontWeight="Bold" Cursor="Hand" Click="TabMagnitud_Click"/>
                        <Button x:Name="BtnTabMasa" Grid.Column="1" Content="Masa" Height="38" Margin="4,0,4,0" 
                                Background="#E2E8F0" Foreground="#334155" FontWeight="SemiBold" Cursor="Hand" Click="TabMagnitud_Click"/>
                        <Button x:Name="BtnTabTemperatura" Grid.Column="2" Content="Temperatura" Height="38" Margin="4,0,0,0" 
                                Background="#E2E8F0" Foreground="#334155" FontWeight="SemiBold" Cursor="Hand" Click="TabMagnitud_Click"/>
                    </Grid>

                    <!-- 2. Valor Numérico -->
                    <TextBlock Text="2. Ingrese el Valor a Convertir:" FontWeight="SemiBold" FontSize="13" Foreground="#334155" Margin="0,0,0,6"/>
                    <TextBox x:Name="TxtValor" Style="{StaticResource ModernTextBox}" 
                             Text="100.00" FontSize="18" FontWeight="Bold" MaxLength="16"
                             PreviewTextInput="TxtValor_PreviewTextInput"
                             TextChanged="TxtValor_TextChanged"
                             Margin="0,0,0,16"/>

                    <!-- 3. Unidades Origen y Destino -->
                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="60"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="De (Unidad de Origen):" FontWeight="SemiBold" FontSize="13" Foreground="#334155" Margin="0,0,0,6"/>
                            <ComboBox x:Name="CmbOrigen" Height="38" FontSize="14"/>
                        </StackPanel>

                        <Button x:Name="BtnIntercambiar" Grid.Column="1" Content="⇄" 
                                FontSize="20" FontWeight="Bold" Width="44" Height="38"
                                VerticalAlignment="Bottom" HorizontalAlignment="Center"
                                Background="#E2E8F0" Foreground="#1E293B" BorderThickness="0"
                                Cursor="Hand" ToolTip="Intercambiar unidades (Origen ⇄ Destino)"
                                Click="BtnIntercambiar_Click"/>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="A (Unidad de Destino):" FontWeight="SemiBold" FontSize="13" Foreground="#334155" Margin="0,0,0,6"/>
                            <ComboBox x:Name="CmbDestino" Height="38" FontSize="14"/>
                        </StackPanel>
                    </Grid>

                    <!-- Botón de Conversión -->
                    <Button x:Name="BtnConvertir" Content="Calcular Conversión REST" 
                            Style="{StaticResource PrimaryButton}" Height="44" FontSize="15"
                            Click="BtnConvertir_Click" Margin="0,0,0,20"/>

                    <!-- 4. Tarjeta de Resultado -->
                    <Border x:Name="BrdResultado" Background="#F0FDF4" BorderBrush="#86EFAC" BorderThickness="1" 
                            CornerRadius="8" Padding="16" Margin="0,0,0,10" Visibility="Collapsed">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock x:Name="LblResultadoValor" Text="100.00 Metro = 10000.00 Centimetro" 
                                           FontSize="18" FontWeight="Bold" Foreground="#15803D"/>
                                <TextBlock Text="Cálculo procesado exitosamente por el Servidor RESTful .NET (SINBDD)." 
                                           FontSize="12" Foreground="#166534" Margin="0,4,0,0"/>
                            </StackPanel>
                            <Button x:Name="BtnCopiar" Grid.Column="1" Content="Copiar Resultado" 
                                    Background="#15803D" Foreground="White" FontWeight="SemiBold"
                                    Padding="12,6" BorderThickness="0" Cursor="Hand" VerticalAlignment="Center"
                                    Click="BtnCopiar_Click"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>
        </ScrollViewer>

        <!-- Pie de Página -->
        <Border Grid.Row="2" Background="#E2E8F0" Padding="16,0">
            <Grid>
                <TextBlock Text="Servidor Backend RESTful: http://192.168.137.1:5000 (Modalidad SINBDD)" 
                           FontSize="10" Foreground="#475569" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                <TextBlock Text="Arquitectura: Modelo - Vista - Controlador (WPF / C# .NET 10)" 
                           FontSize="10" Foreground="#475569" VerticalAlignment="Center" HorizontalAlignment="Right"/>
            </Grid>
        </Border>
    </Grid>
</Window>
